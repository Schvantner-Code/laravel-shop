#!/usr/bin/env bash

set -euo pipefail

documentation_inputs_changed=false

while IFS= read -r path; do
    case "$path" in
        # Only API routes affect Scribe. Including every route caused harmless
        # web-only changes to regenerate random response IDs, timestamps, and
        # Faker examples in all tracked documentation formats.
        app/Http/*|routes/api.php|config/scribe.php)
            documentation_inputs_changed=true
            break
            ;;
        composer.lock)
            # Regenerate for an actual Scribe upgrade, not for unrelated
            # dependency or root-package metadata changes.
            if git diff --cached -- composer.lock | grep -q '\"name\": \"knuckleswtf/scribe\"'; then
                documentation_inputs_changed=true
                break
            fi
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "$documentation_inputs_changed" == false ]]; then
    exit 0
fi

if [[ ! -x ./vendor/bin/sail ]]; then
    echo "Scribe documentation could not be generated: Laravel Sail is not installed." >&2
    echo "Run Composer install, then retry the commit." >&2
    exit 1
fi

if ! ./vendor/bin/sail artisan --version >/dev/null 2>&1; then
    echo "Scribe documentation could not be generated: Laravel Sail is not running." >&2
    echo "Start Sail with './vendor/bin/sail up -d', then retry the commit." >&2
    exit 1
fi

echo "Generating Scribe API documentation..."
./vendor/bin/sail artisan scribe:generate --quiet
git add -- public/docs
echo "Scribe API documentation generated and staged."
